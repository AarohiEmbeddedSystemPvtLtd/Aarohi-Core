<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-windows</TargetFramework>
		<DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
		<UseWindowsForms>true</UseWindowsForms>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!-- Generates XML documentation file for IntelliSense in consuming apps / NuGet users -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Suppresses warning for public members without XML comments -->
		<NoWarn>$(NoWarn);1591</NoWarn>
		<PackageId>Aarohi</PackageId>
		<Version>1.0.14.54</Version>
		<Authors>Aarohi Embedded Systems</Authors>
		<Company>Aarohi Embedded Systems Pvt. Ltd.</Company>
		<Description>Aarohi Core.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="\" />
		<None Include="build\Aarohi.targets" Pack="true" PackagePath="build\" />
		<None Include="..\Aarohi.DbPackager\bin\$(Configuration)\net9.0-windows\**\*.*" Pack="true" PackagePath="build\tools\" />
	</ItemGroup>

  <ItemGroup>
    <!--<PackageReference Include="Aarohi.ExtendedUI" Version="1.0.1" />-->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="EasyModbusTCP.NETCore" Version="1.0.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="ncalc" Version="1.3.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSQLServer" Version="8.1.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.1" />
  </ItemGroup>

	<ItemGroup>
		<None Include="snap7.dll" CopyToOutputDirectory="PreserveNewest" />
		<None Include="snap7.dll" Pack="true" PackagePath="runtimes/win-x86/native" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\..\Projects\Aarohi.ExtendedUI\Aarohi.ExtendedUI\Aarohi.ExtendedUI.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Classes\DynamicCrudForm.cs" />
	  <Compile Update="Classes\ExtendedDropDownList.cs" />
	  <Compile Update="Classes\ExtendedTextBox.cs" />
	  <Compile Update="SQL\FormSqlConnectionManager.cs" />
	  <Compile Update="SQL\FormDbSplash.cs" />
	  <Compile Update="SQL\FormDatabaseCloner.cs" />
	</ItemGroup>
	
</Project>

- name: Debug start
          run: |
            echo "Workflow started"
            echo "Repo: ${{ github.repository }}"
            echo "Branch: ${{ github.ref_name }}"
            echo "Event: ${{ github.event_name }}"
            echo "SHA: ${{ github.sha }}"

        - name: Show changed files count
          run: |
            echo "Changed files file:"
            cat changed_files.txt || true
            echo "Payload preview:"
            cat payload.json | head -n 80

        - name: Upload debug artifacts
          uses: actions/upload-artifact@v4
          with:
            name: docs-sync-debug
            path: |
              changed_files.txt
              payload.json

        - name: Send payload to doc server
          env:
            DOCS_SITE_SYNC_URL: ${{ secrets.DOCS_SITE_SYNC_URL }}
            DOCS_SYNC_SECRET: ${{ secrets.DOCS_SYNC_SECRET }}
          run: |
            curl -sS -X POST "$DOCS_SITE_SYNC_URL" \
              -H "Content-Type: application/json" \
              -H "X-Docs-Secret: $DOCS_SYNC_SECRET" \
              --data-binary @payload.json \
              -w "\nHTTP_STATUS:%{http_code}\n"
<UserControl x:Class="Aarohi.Wpf.Controls.Lib.Controls.Cards.LiveDataCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="88"
             d:DesignWidth="235">

    <Border Background="{DynamicResource AppBrush.Surface}"
            BorderBrush="{DynamicResource AppBrush.Border}"
            BorderThickness="0,0,1,1"
            SnapsToDevicePixels="True"
            ClipToBounds="True">

        <Grid>

            <!-- Corner Accents -->
            <Ellipse Width="10"
                     Height="10"
                     Fill="{DynamicResource AppBrush.Primary}"
                     Opacity="0.65"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-5,-5,0,0"/>

            <Ellipse Width="10"
                     Height="10"
                     Fill="{DynamicResource AppBrush.Primary}"
                     Opacity="0.65"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-5,-5,0"/>

            <Ellipse Width="10"
                     Height="10"
                     Fill="{DynamicResource AppBrush.Primary}"
                     Opacity="0.65"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-5,0,0,-5"/>

            <Ellipse Width="10"
                     Height="10"
                     Fill="{DynamicResource AppBrush.Primary}"
                     Opacity="0.65"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-5,-5"/>


            <!-- ==========================
                 CARD CONTENT
                 ========================== -->
            <Grid Margin="14,8,14,8">

                <Grid.ColumnDefinitions>
                    <!-- Label + Value -->
                    <ColumnDefinition Width="*"/>

                    <!-- Unit -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- PARAMETER -->
                <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="{Binding Label,
                      RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontFamily="Segoe UI Variable Text, Segoe UI"
               FontSize="13"
               FontWeight="Bold"
               Foreground="{DynamicResource AppBrush.TextPrimary}"
               VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis"
               Margin="0,0,12,0"/>


                <!-- VALUE -->
                <Viewbox Grid.Row="1"
             Grid.Column="0"
             Stretch="Uniform"
             StretchDirection="DownOnly"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             MaxHeight="34"
             Margin="0,0,16,0">

                    <TextBlock x:Name="ValueTextBlock"
                   Text="{Binding Value,
                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontFamily="Consolas"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppBrush.TextPrimary}"/>

                </Viewbox>


                <!-- UNIT - CENTERED IN COMPLETE CARD HEIGHT -->
                <TextBlock Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="1"
                           Text="{Binding Unit,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppBrush.Primary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Margin="16,0,10,0"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>
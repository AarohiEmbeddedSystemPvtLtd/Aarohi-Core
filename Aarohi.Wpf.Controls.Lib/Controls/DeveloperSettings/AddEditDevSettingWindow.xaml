<Window x:Class="AarohiWpfControls.Controls.DeveloperSettings.AddEditDevSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Developer Setting"
        Height="560"
        Width="650"
        MinWidth="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙"
                           FontSize="29"
                           Foreground="#475569"
                           Margin="0,0,12,0"/>
                <TextBlock x:Name="WindowHeading"
                           Text="Add Developer Setting"
                           FontSize="23"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="#111827"/>
            </StackPanel>

            <TextBlock Text="Variable Name is the configuration key. Display Name and Value are stored together."
                       FontSize="13"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Variable Name"
                       Style="{StaticResource LabelStyle}"/>

            <TextBox x:Name="VariableNameTextBox"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,0,18"/>

            <TextBlock Text="Display Name"
                       Style="{StaticResource LabelStyle}"/>

            <TextBox x:Name="DisplayNameTextBox"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,0,18"/>

            <TextBlock Text="Value"
                       Style="{StaticResource LabelStyle}"/>

            <TextBox x:Name="ValueTextBox"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,0,18"/>

            <!-- Registry preview -->
            <Border Background="#EAF1FF"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="Registry Key Preview:"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"/>

                    <TextBlock x:Name="RegistryPreviewText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#475569"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="105"
                    Height="42"
                    Margin="0,0,12,0"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    Click="CancelButton_Click"/>

            <Button Content="Save"
                    Width="110"
                    Height="42"
                    Background="#4169E1"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="AarohiWpfControls.Filters.DateFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             MinWidth="700"
             MinHeight="168">

    <UserControl.Resources>

        <SolidColorBrush x:Key="HoverBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#EEF2FF"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding LabelForeground, ElementName=root}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="CleanComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding InputForeground, ElementName=root}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0ECFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="165"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{Binding InputForeground, ElementName=root}"/>
            <Setter Property="Background" Value="{Binding InputBackground, ElementName=root}"/>
            <Setter Property="BorderBrush" Value="{Binding InputBorderBrush, ElementName=root}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CleanComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="OuterBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="12,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>

                                                <Border Grid.Column="1"
                                                        Width="26"
                                                        Height="26"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#F8FAFC"
                                                        CornerRadius="8">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Width="8"
                                                          Height="4"
                                                          Fill="{Binding LabelForeground, ElementName=root}"
                                                          Stretch="Fill"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{Binding AccentBrush, ElementName=root}"/>
                                                <Setter TargetName="OuterBorder" Property="Background" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{Binding AccentBrush, ElementName=root}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Padding="4"
                                        CornerRadius="14"
                                        Background="White"
                                        BorderBrush="#D8E0EC"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="245"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="165"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{Binding InputForeground, ElementName=root}"/>
            <Setter Property="Background" Value="{Binding InputBackground, ElementName=root}"/>
            <Setter Property="BorderBrush" Value="{Binding InputBorderBrush, ElementName=root}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="DateBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Margin="12,0,44,0"
                                               VerticalContentAlignment="Center"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"/>

                            <Button x:Name="PART_Button"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Background="#F1F5F9"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CalBtn"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="9">
                                            <Path Data="M2,3 L12,3 M4,1 L4,5 M10,1 L10,5 M2,5 L12,5 M3,7 L5,7 M7,7 L9,7 M3,9 L5,9 M7,9 L9,9 M2,3 L2,12 L12,12 L12,3 Z"
                                                  Stroke="{Binding AccentBrush, ElementName=root}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stretch="Uniform"
                                                  Width="14"
                                                  Height="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CalBtn" Property="Background" Value="#E0ECFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,6,0,0"
                                        Padding="8"
                                        Background="White"
                                        CornerRadius="16"
                                        BorderBrush="#D8E0EC"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar"
                                              SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              FirstDayOfWeek="Monday"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DateBorder" Property="BorderBrush" Value="{Binding AccentBrush, ElementName=root}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DateBorder" Property="BorderBrush" Value="{Binding AccentBrush, ElementName=root}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding ButtonForeground, ElementName=root}"/>
            <Setter Property="Background" Value="{Binding ButtonBackground, ElementName=root}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{Binding CardBackground, ElementName=root}"
            BorderBrush="{Binding BorderBrushColor, ElementName=root}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="{Binding MainPadding, ElementName=root}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Date Filter"
                               Foreground="{Binding TitleForeground, ElementName=root}"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Choose financial year, month, week, day or custom range"
                               Foreground="{Binding LabelForeground, ElementName=root}"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{Binding BadgeBackground, ElementName=root}"
                        CornerRadius="10"
                        Padding="10,5"
                        VerticalAlignment="Top">
                    <TextBlock Text="Ready"
                               Foreground="{Binding AccentBrush, ElementName=root}"
                               FontSize="11"
                               FontWeight="Bold"/>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Filter Type" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="cmbFilterType"
                              Style="{StaticResource CleanComboBoxStyle}"
                              SelectionChanged="cmbFilterType_SelectionChanged">
                        <ComboBoxItem Content="Financial Year" Tag="FY"/>
                        <ComboBoxItem Content="Month" Tag="Month"/>
                        <ComboBoxItem Content="Week" Tag="Week"/>
                        <ComboBoxItem Content="Day" Tag="Day"/>
                        <ComboBoxItem Content="Custom Range" Tag="Custom"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="txtPrimaryLabel" Text="Select" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="cmbPrimary"
                              Style="{StaticResource CleanComboBoxStyle}"
                              SelectionChanged="cmbPrimary_SelectionChanged"/>
                    <DatePicker x:Name="dpFrom"
                                Visibility="Collapsed"
                                Style="{StaticResource CleanDatePickerStyle}"
                                SelectedDateChanged="dpFrom_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock x:Name="txtSecondaryLabel" Text="Value" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="cmbSecondary"
                              Style="{StaticResource CleanComboBoxStyle}"
                              SelectionChanged="cmbSecondary_SelectionChanged"/>
                    <DatePicker x:Name="dpTo"
                                Visibility="Collapsed"
                                Style="{StaticResource CleanDatePickerStyle}"
                                SelectedDateChanged="dpTo_SelectedDateChanged"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4"
                    Background="{Binding FooterBackground, ElementName=root}"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Range:"
                                   Foreground="{Binding LabelForeground, ElementName=root}"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                        <TextBlock Margin="6,0,0,0"
                                   Foreground="{Binding ValueForeground, ElementName=root}"
                                   FontSize="13"
                                   FontWeight="SemiBold">
                            <Run Text="{Binding StartDate, ElementName=root, StringFormat={}{0:dd-MMM-yyyy}}"/>
                            <Run Text="  to  "/>
                            <Run Text="{Binding EndDate, ElementName=root, StringFormat={}{0:dd-MMM-yyyy}}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Apply"
                            Style="{StaticResource ApplyButtonStyle}"
                            Click="BtnApply_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

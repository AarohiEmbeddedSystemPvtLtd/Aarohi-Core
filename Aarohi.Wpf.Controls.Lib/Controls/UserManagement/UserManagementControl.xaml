<UserControl x:Class="Aarohi.Wpf.Controls.Lib.Controls.UserManagement.UserManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aarohi.Wpf.Controls.Lib.Controls.UserManagement"
             xmlns:dg="clr-namespace:Aarohi.Wpf.Controls.Lib.Controls.DataGridView"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Background="{DynamicResource AppBrush.Surface}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="16"
                          Direction="270"
                          Opacity="0.06"
                          ShadowDepth="4"
                          Color="#000000" />

        <!-- TEXT -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
        </Style>

        <Style x:Key="SubTitleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- CARD -->
        <Style x:Key="CardBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource AppBrush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- NORMAL BUTTON -->
        <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppBrush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlHover}"/>
                                <Setter TargetName="BtnBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.BorderStrong}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlPressed}"/>
                                <Setter TargetName="BtnBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.BorderStrong}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ModernButtonStyle}">

            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextOnAccent}"/>
            <Setter Property="Background" Value="{DynamicResource AppBrush.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Primary}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.PrimaryHover}"/>
                                <Setter TargetName="BtnBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.PrimaryHover}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.PrimaryPressed}"/>
                                <Setter TargetName="BtnBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.PrimaryPressed}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER BUTTON -->
        <Style x:Key="DangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextOnAccent}"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <!-- ROUNDED HEADER BUTTON -->
        <Style x:Key="RoundedHeaderButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppBrush.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlHover}"/>
                                <Setter TargetName="BtnBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlPressed}"/>
                                <Setter TargetName="BtnBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.PrimaryPressed}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppBrush.PrimaryPressed}"/>
                                <Setter TargetName="BtnBorder"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX -->
        <Style x:Key="ModernTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppBrush.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppBrush.Primary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.BorderStrong}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PASSWORD BOX -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppBrush.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppBrush.Primary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.BorderStrong}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX -->
        <Style x:Key="ModernComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlHover}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppBrush.TextOnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Arrow"
                                  Width="11"
                                  Height="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M1,1 L5.5,5.5 L10,1"
                                  Stroke="{DynamicResource AppBrush.TextSecondary}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow"
                                        Property="Stroke"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow"
                                        Property="RenderTransformOrigin"
                                        Value="0.5,0.5"/>
                                <Setter TargetName="Arrow"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Arrow"
                                        Property="Stroke"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource AppBrush.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">

                            <Border x:Name="MainBorder"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      RecognizesAccessKey="True"/>

                                    <ToggleButton x:Name="DropDownToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ComboBoxToggleButtonStyle}"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">

                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Margin="0,6,0,0">

                                    <Border Background="{DynamicResource AppBrush.Surface}"
                                            BorderBrush="{DynamicResource AppBrush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4"
                                            Effect="{StaticResource CardShadowEffect}">

                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="True">

                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.BorderStrong}"/>
                                <Setter TargetName="MainBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlHover}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.Primary}"/>
                                <Setter TargetName="MainBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlPressed}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHECKBOX -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TREEVIEW -->
        <Style TargetType="{x:Type TreeView}">
            <Setter Property="Background" Value="{DynamicResource AppBrush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <StackPanel>
                            <Border x:Name="TreeItemBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,6"
                                    SnapsToDevicePixels="True">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,4,0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Visibility="Hidden">

                                        <Path x:Name="Arrow"
                                              Width="7"
                                              Height="7"
                                              Stretch="Uniform"
                                              Data="M1,1 L5,4 L1,7"
                                              Stroke="{DynamicResource AppBrush.TextSecondary}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </ToggleButton>

                                    <ContentPresenter Grid.Column="1"
                                                      x:Name="PART_Header"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="18,3,0,0"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <Trigger SourceName="Expander" Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TreeItemBorder" Property="Background" Value="{DynamicResource AppBrush.ControlHover}"/>
                                <Setter TargetName="TreeItemBorder" Property="BorderBrush" Value="{DynamicResource AppBrush.BorderStrong}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TreeItemBorder" Property="Background" Value="{DynamicResource AppBrush.Primary}"/>
                                <Setter TargetName="TreeItemBorder" Property="BorderBrush" Value="{DynamicResource AppBrush.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextOnAccent}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TreeItemBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:UserTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{DynamicResource AppBrush.SurfaceAlt}"
                        BorderBrush="{DynamicResource AppBrush.Border}"
                        BorderThickness="1"
                        Margin="0,0,8,0">

                    <TextBlock Text="{Binding Initial}"
                               FontWeight="Bold"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Primary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AppBrush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextOnAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Role}" FontSize="11" Margin="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextOnAccent}"/>
                                        <Setter Property="Opacity" Value="0.82"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="CenterDataGridTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}"/>
        </Style>

    </UserControl.Resources>

    <DockPanel x:Name="RootDockPanel"
               LastChildFill="True"
               Margin="18"
               Background="{DynamicResource AppBrush.Surface}">

        <!-- TOP HEADER CARD -->
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,18"
                Padding="14"
                Background="{DynamicResource AppBrush.Surface}"
                CornerRadius="12"
                BorderBrush="{DynamicResource AppBrush.Border}"
                BorderThickness="1"
                Effect="{StaticResource CardShadowEffect}">

            <Grid x:Name="HeaderGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow0" Height="Auto"/>
                    <RowDefinition x:Name="HeaderRow1" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderCol0" Width="*"/>
                    <ColumnDefinition x:Name="HeaderCol1" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="HeaderTitleStack"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="User Management"
                               Style="{StaticResource TitleTextStyle}"/>

                    <TextBlock Text="Manage application users, hierarchy, roles and permissions."
                               Style="{StaticResource SubTitleTextStyle}"/>
                </StackPanel>

                <StackPanel x:Name="HeaderButtonsStack"
                            Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- NEW USER -->
                    <Button x:Name="ButtonNewUser"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ButtonNewUser_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Data="M7,2 L7,12 M2,7 L12,7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeEndLineCap="Round"
                                  StrokeThickness="1.8"/>
                            <TextBlock Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="New User"/>
                        </StackPanel>
                    </Button>

                    <!-- SAVE -->
                    <Button x:Name="ButtonSaveUser"
                            Style="{StaticResource RoundedHeaderButtonStyle}"
                            Click="ButtonSaveUser_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppBrush.SurfaceAlt}"
                                    VerticalAlignment="Center">
                                <Path Width="13"
                                      Height="13"
                                      Data="M3,3 L11,3 L11,11 L3,11 Z M5,3 L5,6 L9,6 L9,3 M5,9 L9,9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Margin="9,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="Save"/>
                        </StackPanel>
                    </Button>

                    <!-- DELETE -->
                    <Button x:Name="ButtonDeleteUser"
                            Style="{StaticResource RoundedHeaderButtonStyle}"
                            Click="ButtonDeleteUser_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppBrush.SurfaceAlt}"
                                    VerticalAlignment="Center">
                                <Path Width="13"
                                      Height="13"
                                      Data="M4,5 L10,5 M5,5 L5.5,12 M8.5,12 L9,5 M5,3 L9,3 M6,3 L6.5,2 L7.5,2 L8,3"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Margin="9,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="Delete"/>
                        </StackPanel>
                    </Button>

                    <!-- REFRESH -->
                    <Button x:Name="ButtonRefresh"
                            Style="{StaticResource RoundedHeaderButtonStyle}"
                            Click="ButtonRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppBrush.SurfaceAlt}"
                                    VerticalAlignment="Center">
                                <Path Width="13"
                                      Height="13"
                                      Data="M10,4 A4,4 0 1 0 11,8 M10,4 L10,2 M10,4 L8,4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1.6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Margin="9,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                       Text="Refresh"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SUMMARY CARDS -->
            <Grid x:Name="SummaryCardsGrid"
                  Grid.Row="0"
                  Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SummaryRow0" Height="Auto"/>
                    <RowDefinition x:Name="SummaryRow1" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryCol0" Width="*"/>
                    <ColumnDefinition x:Name="SummaryCol1" Width="*"/>
                    <ColumnDefinition x:Name="SummaryCol2" Width="*"/>
                    <ColumnDefinition x:Name="SummaryCol3" Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="BorderTotalUsers"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Users"
                                   Foreground="{DynamicResource AppBrush.TextSecondary}"
                                   FontSize="12"/>
                        <TextBlock x:Name="TextBlockTotalUsers"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppBrush.TextPrimary}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BorderRootUsers"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Root Users"
                                   Foreground="{DynamicResource AppBrush.TextSecondary}"
                                   FontSize="12"/>
                        <TextBlock x:Name="TextBlockRootUsers"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppBrush.Primary}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BorderSelectedUser"
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Selected User"
                                   Foreground="{DynamicResource AppBrush.TextSecondary}"
                                   FontSize="12"/>
                        <TextBlock x:Name="TextBlockSelectedUser"
                                   Text="New"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppBrush.TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BorderPermissions"
                        Grid.Row="0"
                        Grid.Column="3"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="Permissions"
                                   Foreground="{DynamicResource AppBrush.TextSecondary}"
                                   FontSize="12"/>
                        <TextBlock x:Name="TextBlockTotalPermissions"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppBrush.Primary}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BODY -->
            <Grid x:Name="BodyGrid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="BodyRow0" Height="*"/>
                    <RowDefinition x:Name="BodyRow1" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BodyCol0" Width="310"/>
                    <ColumnDefinition x:Name="BodyCol1" Width="*"/>
                    <ColumnDefinition x:Name="BodyCol2" Width="410"/>
                </Grid.ColumnDefinitions>

                <!-- USER HIERARCHY -->
                <Border x:Name="BorderUserHierarchy"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,14,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="User Hierarchy" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="ParentID based reporting structure" Style="{StaticResource SubTitleTextStyle}"/>
                        </StackPanel>
                        <TreeView x:Name="TreeViewUsers" SelectedItemChanged="TreeViewUsers_SelectedItemChanged"/>
                    </DockPanel>
                </Border>

                <!-- USER GRID -->
                <Border x:Name="BorderUserDataGrid"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Users" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="Application login users" Style="{StaticResource SubTitleTextStyle}"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Height="38">
                                <TextBox x:Name="TextBoxSearch"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Padding="40,0,12,0"
                                         ToolTip="Search by User name, Email, Role or Parent"
                                         TextChanged="TextBoxSearch_TextChanged"/>
                                <Path Width="15"
                                      Height="15"
                                      Margin="14,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      IsHitTestVisible="False"
                                      Stroke="{DynamicResource AppBrush.TextSecondary}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M9.5,9.5 L14,14 M6.5,11.5 C3.7,11.5 1.5,9.3 1.5,6.5 C1.5,3.7 3.7,1.5 6.5,1.5 C9.3,1.5 11.5,3.7 11.5,6.5 C11.5,9.3 9.3,11.5 6.5,11.5"/>
                            </Grid>
                        </Grid>

                        <dg:ExtendedDataGridView x:Name="DataGridUsers"
                                                Grid.Row="1"
                                                SelectionChanged="DataGridUsers_SelectionChanged"
                                                AutoGenerateColumns="False">
                            <dg:ExtendedDataGridView.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding UserID}" ElementStyle="{StaticResource CenterDataGridTextStyle}" Width="65"/>
                                <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" ElementStyle="{StaticResource CenterDataGridTextStyle}" Width="150"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" ElementStyle="{StaticResource CenterDataGridTextStyle}" Width="220"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" ElementStyle="{StaticResource CenterDataGridTextStyle}" Width="120"/>
                                <DataGridTextColumn Header="Parent" Binding="{Binding ParentUserName}" ElementStyle="{StaticResource CenterDataGridTextStyle}" Width="150"/>
                                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAtText}" ElementStyle="{StaticResource CenterDataGridTextStyle}" Width="155"/>
                                <DataGridTextColumn Header="Modified At" Binding="{Binding ModifiedAtText}" ElementStyle="{StaticResource CenterDataGridTextStyle}" Width="155"/>
                            </dg:ExtendedDataGridView.Columns>
                        </dg:ExtendedDataGridView>
                    </Grid>
                </Border>

                <!-- USER DETAILS -->
                <Border x:Name="BorderUserDetails"
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="User Details" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Create or update selected user" Style="{StaticResource SubTitleTextStyle}" Margin="0,4,0,16"/>

                            <TextBlock Text="User Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TextBoxUserName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TextBoxEmail" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                            <PasswordBox x:Name="PasswordBoxPassword" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabelStyle}"/>
                            <PasswordBox x:Name="PasswordBoxConfirmPassword" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ComboBoxRole" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12">
                                <ComboBoxItem Content="Admin"/>
                                <ComboBoxItem Content="Supervisor"/>
                                <ComboBoxItem Content="Engineer"/>
                                <ComboBoxItem Content="Operator"/>
                                <ComboBoxItem Content="Viewer"/>
                            </ComboBox>

                            <TextBlock Text="Parent User" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ComboBoxParentUser"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      DisplayMemberPath="UserName"
                                      SelectedValuePath="UserID"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="UserName"
                                      Margin="0,0,0,14"/>

                            <Border Background="{DynamicResource AppBrush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource AppBrush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <TextBlock Text="Note: Existing UpdateUserProcedure requires password and confirm password during update."
                                           Foreground="{DynamicResource AppBrush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           FontSize="12"/>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Permissions" Style="{StaticResource SectionTitleTextStyle}" FontSize="15"/>
                                <Button Grid.Column="1"
                                        Content="Select All"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Height="30"
                                        MinWidth="80"
                                        Padding="10,0"
                                        Click="ButtonSelectAllPermissions_Click"/>
                            </Grid>

                            <Border Background="{DynamicResource AppBrush.Control}"
                                    BorderBrush="{DynamicResource AppBrush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    MinHeight="120">
                                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsControlPermissions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding PermissionName}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

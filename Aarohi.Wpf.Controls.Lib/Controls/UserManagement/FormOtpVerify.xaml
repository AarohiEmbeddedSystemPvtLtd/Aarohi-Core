<Window x:Class="Aarohi.Wpf.Controls.Lib.Controls.UserManagement.FormOtpVerify"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OTP Verification"
        Width="430"
        Height="285"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <DropShadowEffect x:Key="OtpCardShadowEffect"
                          BlurRadius="22"
                          ShadowDepth="4"
                          Opacity="0.20" />

        <!-- MODERN TEXTBOX -->
        <Style x:Key="ModernOtpTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource AppBrush.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppBrush.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.BorderStrong}" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.Primary}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NORMAL MODERN BUTTON -->
        <Style x:Key="ModernOtpButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource AppBrush.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlHover}" />

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.BorderStrong}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.ControlPressed}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY VERIFY BUTTON -->
        <Style x:Key="PrimaryOtpButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ModernOtpButtonStyle}">

            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource AppBrush.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Primary}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.PrimaryHover}" />

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.PrimaryHover}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppBrush.PrimaryPressed}" />

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppBrush.PrimaryPressed}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="Transparent">

        <Border Width="390"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AppBrush.Surface}"
                BorderBrush="{DynamicResource AppBrush.Border}"
                BorderThickness="1"
                CornerRadius="18"
                Effect="{StaticResource OtpCardShadowEffect}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OTP Verification"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppBrush.TextPrimary}" />

                        <TextBlock Text="Enter the OTP sent to the user email."
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppBrush.TextSecondary}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            Padding="0"
                            Content="×"
                            FontSize="18"
                            FontWeight="Bold"
                            Style="{StaticResource ModernOtpButtonStyle}"
                            Click="ButtonClose_Click" />
                </Grid>

                <!-- Label -->
                <TextBlock Grid.Row="2"
                           Text="Enter OTP"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppBrush.TextSecondary}" />

                <!-- OTP Input -->
                <TextBox x:Name="TextBoxOtp"
                         Grid.Row="4"
                         MaxLength="6"
                         Style="{StaticResource ModernOtpTextBoxStyle}"
                         PreviewTextInput="TextBoxOtp_PreviewTextInput"
                         KeyDown="TextBoxOtp_KeyDown" />

                <!-- Status Message -->
                <TextBlock x:Name="TextBlockMessage"
                           Grid.Row="6"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppBrush.TextSecondary}" />

                <!-- Buttons -->
                <StackPanel Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Width="96"
                            Style="{StaticResource ModernOtpButtonStyle}"
                            Click="ButtonCancel_Click" />

                    <Button Content="Verify OTP"
                            Width="116"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryOtpButtonStyle}"
                            Click="ButtonVerify_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

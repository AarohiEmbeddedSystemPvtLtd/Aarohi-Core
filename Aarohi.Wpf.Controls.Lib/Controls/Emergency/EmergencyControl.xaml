<UserControl x:Class="Aarohi.Wpf.Controls.Lib.Controls.Emergency.EmergencyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             >

    <UserControl.Resources>

        <!-- Emergency Card Style -->
        <Style x:Key="EmergencyCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Status Text Style -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.Primary}"/>
        </Style>

        <Style x:Key="StatusTextStyleDisc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextMuted}"/>
        </Style>

    </UserControl.Resources>

    <Border CornerRadius="24"
        Background="{DynamicResource AppBrush.Background}"
        BorderBrush="{DynamicResource AppBrush.Border}"
        BorderThickness="1"
        Padding="0"
        Margin="20"
        SnapsToDevicePixels="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="35"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.28"
                          Color="Black"/>
        </Border.Effect>

        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
        Background="{DynamicResource AppBrush.SurfaceAlt}"
        Padding="18"
        BorderBrush="{DynamicResource AppBrush.Border}"
        BorderThickness="0,0,0,1"
        CornerRadius="24,24,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

                        <TextBlock Text="✘ Emergency Detected!"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppBrush.Danger}"/>

                        <TextBlock Text="PLC emergency and safety condition validation"
                       FontSize="14"
                       Foreground="{DynamicResource AppBrush.TextMuted}"
                       Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button x:Name="StopButton"
                Grid.Column="1"
                Content="STOP"
                Click="StopButton_Click"
                VerticalAlignment="Center"
                Margin="24,0,0,0"
                Padding="28,12"
                Background="{DynamicResource AppBrush.Danger}"
                Foreground="White"
                BorderThickness="0"
                FontSize="15"
                FontWeight="Bold"
                Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">

                                    <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                        <TextBlock Text="■"
                                       FontSize="12"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>

                                        <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.72"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Emergency Conditions -->
            <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" VerticalAlignment="Center" HorizontalAlignment="Center">

                <UniformGrid Columns="2"
                         Margin="15">

                    <!-- Emergency -->
                    <Border x:Name="cardEmergency"
                        Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                     Direction="270"
                                     Opacity="0.06"
                                     ShadowDepth="4"
                                     Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Emergency"
                                       Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Checks emergency push button condition"
                                       Style="{StaticResource StatusTextStyleDisc}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                   x:Name="txtEmergency"
                                   Text="OK"
                                   Foreground="{DynamicResource AppBrush.Success}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Drive Communication -->
                    <Border x:Name="cardDriveCommunication"
                        Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
           Direction="270"
           Opacity="0.06"
           ShadowDepth="4"
           Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Drive Communication"
                                       Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Checks drive communication condition"
                                       Style="{StaticResource StatusTextStyleDisc}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                   x:Name="txtDriveCommunication"
                                   Text="OK"
                                    Foreground="{DynamicResource AppBrush.Success}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Overload -->
                    <Border x:Name="cardOverCurrent"
                        Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                    Direction="270"
                                    Opacity="0.06"
                                    ShadowDepth="4"
                                    Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>


                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Over Current"
                                       Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Checks over current condition"
                                       Style="{StaticResource StatusTextStyleDisc}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                   x:Name="txtOverCurrent"
                                   Text="OK"
                                   Foreground="{DynamicResource AppBrush.Success}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Drive Status -->
                    <Border x:Name="cardDriveStatus"
                        Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
           Direction="270"
           Opacity="0.06"
           ShadowDepth="4"
           Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Drive Status"
                                       Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Checks VFD or drive status"
                                       Style="{StaticResource StatusTextStyleDisc}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                   x:Name="txtDriveSattus"
                                   Text="OK"
                                   Foreground="{DynamicResource AppBrush.Success}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Power Failure -->
                    <Border x:Name="cardPowerFailure"
                        Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
           Direction="270"
           Opacity="0.06"
           ShadowDepth="4"
           Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Power Failure"
                                       Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Checks power Connection"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                   x:Name="txtPowerFailure"
                                   Text="OK"
                                   Foreground="{DynamicResource AppBrush.Success}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Over Load -->
                    <Border x:Name="cardOverLoad"
                        Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                     Direction="270"
                                     Opacity="0.06"
                                     ShadowDepth="4"
                                     Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Over Load"
                                       Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Check it is overloaded or not"
                                       Style="{StaticResource StatusTextStyleDisc}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                   x:Name="txtOverLoad"
                                   Text="OK"
                                   Foreground="{DynamicResource AppBrush.Success}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!--RPM Validation-->
                    <Border x:Name="cardRPMValidation"
                    Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                 Direction="270"
                                 Opacity="0.06"
                                 ShadowDepth="4"
                                 Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="RPM validation"
                        Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Checks RPM Speed"
                        Style="{StaticResource StatusTextStyleDisc}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                    x:Name="txtRPMValidation"
                    Text="OK"
                    Foreground="{DynamicResource AppBrush.Success}"
                    FontSize="16"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!--Transducer Status-->
                    <Border x:Name="cardTranducerStatus"
                      Style="{StaticResource EmergencyCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
           Direction="270"
           Opacity="0.06"
           ShadowDepth="4"
           Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="29*"/>
                                <ColumnDefinition Width="230*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,3,0,0" Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="50" Background="{DynamicResource AppBrush.Accent}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="2">
                                <TextBlock Text="Transducer Status"
                        Style="{StaticResource StatusTextStyle}"/>
                                <TextBlock Text="Checks tranducer"
                        Style="{StaticResource StatusTextStyleDisc}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                    x:Name="txtTranducerStatus"
                    Text="OK"
                    Foreground="{DynamicResource AppBrush.Success}"
                    FontSize="16"
                    FontWeight="Bold"
                    VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="230,0,0,0"/>
                        </Grid>
                    </Border>

                </UniformGrid>
            </ScrollViewer>

            <!-- Footer Message -->
            <Border Grid.Row="2"
                Background="{DynamicResource AppBrush.SurfaceAlt}"
                Padding="16"
                BorderBrush="#374151"
                BorderThickness="0,1,0,0"
                    CornerRadius="0,0,24,24">

                <TextBlock x:Name="txtValidationMessage"
                       Text="No emergency condition detected. Machine is ready."
                       Foreground="{DynamicResource AppBrush.TextPrimary}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            </Border>

        </Grid>
    </Border>
</UserControl>
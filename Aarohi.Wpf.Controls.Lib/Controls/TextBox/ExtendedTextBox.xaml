<UserControl x:Class="Aarohi.Wpf.Controls.Lib.Controls.TextBox.ExtendedTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aarohi.Wpf.Controls.Lib.Controls.TextBox"
             mc:Ignorable="d" d:DesignHeight="26" d:DesignWidth="190">
    <Grid Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Name="ColLeft" Width="Auto" />
            <ColumnDefinition Width="4" />
            <!-- Gap -->
            <ColumnDefinition Name="ColRight" Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="txtLeft" 
                 Grid.Column="0" 
                 VerticalAlignment="Center" 
                 BorderBrush="Gray" 
                 BorderThickness="1"
                 TextChanged="TxtLeft_TextChanged" 
                 PreviewTextInput="TxtLeft_PreviewTextInput"/>

        <ComboBox x:Name="cmbRight" 
                  Grid.Column="2" 
                  VerticalAlignment="Center" 
                  IsEditable="False"
                  SelectionChanged="CmbRight_SelectionChanged"/>
    </Grid>
</UserControl>

<Window x:Class="Aarohi.Wpf.Controls.Lib.Controls.MessageBox.ModernMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Message"
        Width="540"
        MinWidth="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernMessageBoxTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WPF displays FocusVisualStyle only for keyboard-initiated focus.
                 Keeping focus outside the button template prevents mouse clicks
                 from producing the former stacked/double-border appearance. -->
            <Style x:Key="MessageButtonFocusVisualStyle" TargetType="{x:Type Control}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Margin="2"
                                    BorderBrush="{DynamicResource Aarohi.ModernMessageBox.FocusBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HeaderButtonFocusVisualStyle" TargetType="{x:Type Control}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Margin="2"
                                    BorderBrush="{DynamicResource Aarohi.ModernMessageBox.TextOnAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="15" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MessageButtonBaseStyle" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="95" />
                <Setter Property="Margin" Value="8,4,0,4" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource MessageButtonFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MessageButtonBaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource Aarohi.ModernMessageBox.TextOnAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource Aarohi.ModernMessageBox.PrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Aarohi.ModernMessageBox.PrimaryHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Aarohi.ModernMessageBox.PrimaryPressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MessageButtonBaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource Aarohi.ModernMessageBox.TextPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource Aarohi.ModernMessageBox.ControlBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Aarohi.ModernMessageBox.BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Aarohi.ModernMessageBox.PrimarySubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Aarohi.ModernMessageBox.PrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Aarohi.ModernMessageBox.ControlPressedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Aarohi.ModernMessageBox.PrimaryPressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DangerButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MessageButtonBaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource Aarohi.ModernMessageBox.TextOnAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource Aarohi.ModernMessageBox.DangerBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.88" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.75" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Foreground" Value="{DynamicResource Aarohi.ModernMessageBox.TextOnAccentBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource HeaderButtonFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="17">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MessageScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbChrome"
                                                        Margin="1,0"
                                                        Background="{DynamicResource Aarohi.ModernMessageBox.BorderStrongBrush}"
                                                        CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background"
                                                                Value="{DynamicResource Aarohi.ModernMessageBox.PrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource Aarohi.ModernMessageBox.SurfaceBrush}"
                BorderBrush="{DynamicResource Aarohi.ModernMessageBox.BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Color="#111827"
                                  Direction="270"
                                  Opacity="0.32"
                                  RenderingBias="Quality"
                                  ShadowDepth="6" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Aarohi.ModernMessageBox.PrimaryBrush}"
                        CornerRadius="18,18,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleTextBlock"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Aarohi.ModernMessageBox.TextOnAccentBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="CloseButton"
                                Grid.Column="1"
                                Style="{StaticResource CloseButtonStyle}"
                                ToolTip="Close"
                                automation:AutomationProperties.Name="Close message"
                                Click="CloseButton_Click">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M2,2 L10,10 M10,2 L2,10" Stroke="White" StrokeThickness="1.8" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ContentScroller"
                              Grid.Row="1"
                              Padding="0,0,5,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource MessageScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel Margin="22,16,17,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconBorder"
                                    Width="46" Height="46"
                                    VerticalAlignment="Top"
                                    CornerRadius="23">
                                <Path x:Name="IconPath"
                                      Width="24" Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="MessageTextBlock"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="15"
                                       Foreground="{DynamicResource Aarohi.ModernMessageBox.TextSecondaryBrush}"
                                       LineHeight="24"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.Name="Message text" />
                        </Grid>

                        <ContentControl x:Name="AdditionalContentPresenter"
                                        Margin="60,14,0,0"
                                        Visibility="Collapsed" />

                        <Expander x:Name="DetailsExpander"
                                  Margin="60,14,0,0"
                                  Header="Details"
                                  Foreground="{DynamicResource Aarohi.ModernMessageBox.TextPrimaryBrush}"
                                  Visibility="Collapsed">
                            <Border Margin="0,8,0,0"
                                    Padding="10"
                                    Background="{DynamicResource Aarohi.ModernMessageBox.SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource Aarohi.ModernMessageBox.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBox x:Name="DetailsTextBox"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         Foreground="{DynamicResource Aarohi.ModernMessageBox.TextSecondaryBrush}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        MinHeight="64"
                        Padding="14,8,22,8"
                        Background="{DynamicResource Aarohi.ModernMessageBox.SurfaceAltBrush}"
                        CornerRadius="0,0,18,18">
                    <WrapPanel x:Name="ButtonsPanel"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Orientation="Horizontal" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

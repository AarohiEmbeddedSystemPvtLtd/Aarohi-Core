<UserControl x:Class="AarohiWpfControls.Controls.DropDown.DropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AarohiWpfControls.Controls.DropDown"
             x:Name="root" mc:Ignorable="d" d:DesignHeight="40" d:DesignWidth="360">
    <UserControl.Resources>

        <!-- Palette circles: selected state -->
        <DataTemplate x:Key="PaletteCircleTemplateSmall">
            <Border Width="16"
                    Height="16"
                    Margin="-4,0,0,0"
                    CornerRadius="8"
                    Background="{Binding}"
                    BorderBrush="{Binding PaletteCircleBorderBrush, ElementName=root}"
                    BorderThickness="1"/>
        </DataTemplate>

        <!-- Palette circles: popup items -->
        <DataTemplate x:Key="PaletteCircleTemplateLarge">
            <Border Width="18"
                    Height="18"
                    Margin="-4,0,0,0"
                    CornerRadius="9"
                    Background="{Binding}"
                    BorderBrush="{Binding PaletteCircleBorderBrush, ElementName=root}"
                    BorderThickness="1"/>
        </DataTemplate>

        <!-- Popup item -->
        <DataTemplate x:Key="ThemeItemTemplate">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ThemeName}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{Binding TextBrush, ElementName=root}"/>

                <ItemsControl Grid.Column="1"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Colors}"
                              ItemTemplate="{StaticResource PaletteCircleTemplateLarge}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Selected item -->
        <DataTemplate x:Key="SelectedThemeTemplate">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ThemeName}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{Binding TextBrush, ElementName=root}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"/>

                <ItemsControl Grid.Column="1"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Colors}"
                              ItemTemplate="{StaticResource PaletteCircleTemplateSmall}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Popup item container -->
        <Style x:Key="PremiumComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="4,3"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{Binding PopupItemHoverBrush, ElementName=root}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{Binding PopupItemSelectedBrush, ElementName=root}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main ComboBox style -->
        <Style x:Key="PremiumThemeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{Binding TextBrush, ElementName=root}"/>
            <Setter Property="Background" Value="{Binding ControlBackgroundBrush, ElementName=root}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderBrushEx, ElementName=root}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PremiumComboBoxItemStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected content -->
                                    <Grid Grid.Column="0"
                                          Margin="10,0,4,0"
                                          VerticalAlignment="Center">
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{StaticResource SelectedThemeTemplate}"
                                                          VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Arrow area -->
                                    <Border x:Name="ArrowPanel"
                                            Grid.Column="1"
                                            Margin="3"
                                            CornerRadius="8"
                                            Background="{Binding ArrowPanelBrush, ElementName=root}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              ShadowDepth="1"
                                                              Opacity="0.18"/>
                                        </Border.Effect>

                                        <ToggleButton x:Name="DropDownToggle"
                                                      Focusable="False"
                                                      Background="Transparent"
                                                      BorderBrush="{x:Null}"
                                                      BorderThickness="0"
                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      ClickMode="Press">
                                            <Grid>
                                                <Path x:Name="ArrowPath"
                                                      Width="8"
                                                      Height="5"
                                                      Stretch="Fill"
                                                      Fill="{Binding ArrowIconBrush, ElementName=root}"
                                                      Data="M 0 0 L 10 0 L 5 6 Z"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </ToggleButton>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,8,0,0"
                                        Padding="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{Binding PopupBackgroundBrush, ElementName=root}"
                                        BorderBrush="{Binding PopupBorderBrush, ElementName=root}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="2"
                                                          Opacity="0.12"/>
                                    </Border.Effect>

                                    <ScrollViewer MaxHeight="320"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="{Binding HoverBorderBrush, ElementName=root}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="{Binding FocusBorderBrush, ElementName=root}"/>
                            </Trigger>

                            <Trigger SourceName="DropDownToggle" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowPanel"
                                        Property="Background"
                                        Value="{Binding ArrowPanelHoverBrush, ElementName=root}"/>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush"
                                        Value="{Binding FocusBorderBrush, ElementName=root}"/>
                                <Setter TargetName="ArrowPanel"
                                        Property="Background"
                                        Value="{Binding ArrowPanelOpenBrush, ElementName=root}"/>
                                <Setter TargetName="ArrowPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ComboBox x:Name="cmbThemes"
                  Style="{StaticResource PremiumThemeComboBoxStyle}"
                  ItemsSource="{Binding ThemeItems, ElementName=root}"
                  SelectedItem="{Binding SelectedTheme, ElementName=root, Mode=TwoWay}"
                  ItemTemplate="{StaticResource ThemeItemTemplate}"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Center"/>

        <TextBlock Text="Select theme"
                   Margin="14,0,40,0"
                   VerticalAlignment="Center"
                   Foreground="{Binding PlaceholderBrush, ElementName=root}"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTheme, ElementName=root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>

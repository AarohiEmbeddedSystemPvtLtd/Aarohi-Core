<UserControl x:Class="Aarohi.Wpf.Controls.Lib.Controls.DataGridView.ExtendedDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aarohi.Wpf.Controls.Lib.Controls.DataGridView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="HeaderDropDownButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <Path Data="M 0 0 L 6 0 L 3 4 Z" Fill="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FilterHeaderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,2,0"/>
                <ToggleButton Grid.Column="1" Style="{StaticResource HeaderDropDownButton}" VerticalAlignment="Center" Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Click="FilterButton_Click"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="FilterColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardHeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="ContentTemplate" Value="{StaticResource FilterHeaderTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CardBgBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PagingButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource WindowActionButtonBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WindowActionButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CardBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource PillTabBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,2,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource PillTabHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="PART_Grid" Grid.Row="0"
                  HorizontalAlignment="Stretch"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource CardContentBorderBrush}"
                  AlternationCount="2"
                  ColumnHeaderStyle="{StaticResource FilterColumnHeaderStyle}"
                  RowStyle="{StaticResource DataRowStyle}"
                  CellStyle="{StaticResource DataCellStyle}"
                  Background="{DynamicResource CardBgBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1,1,1,0"
                  RowHeaderWidth="0"
                  EnableColumnVirtualization="False"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Sorting="PART_Grid_Sorting"
                  MouseRightButtonUp="PART_Grid_MouseRightButtonUp"
                  MouseDoubleClick="PART_Grid_MouseDoubleClick"
                  LoadingRow="PART_Grid_LoadingRow"
                  UnloadingRow="PART_Grid_UnloadingRow"
                  SelectionChanged="PART_Grid_SelectionChanged"
                  CellEditEnding="PART_Grid_CellEditEnding"
                  BeginningEdit="PART_Grid_BeginningEdit"
                  PreviewKeyDown="PART_Grid_PreviewKeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="RowContextMenu" Visibility="Collapsed">
                    <MenuItem Header="View" Click="RowMenu_View_Click"/>
                    <MenuItem Header="Edit" Click="RowMenu_Edit_Click"/>
                    <Separator/>
                    <MenuItem Header="Delete" Click="RowMenu_Delete_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        

        <Border Grid.Row="1" Background="{DynamicResource FooterBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,1,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PART_RowInfo" Text="0 rows" FontSize="11" FontFamily="Segoe UI" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Rows/page:" FontSize="11" FontFamily="Segoe UI" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="PART_PageSizeCombo" Width="60" Height="24" FontSize="11" VerticalContentAlignment="Center" SelectionChanged="PageSizeCombo_SelectionChanged" Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                        <ComboBoxItem Content="25"/>
                        <ComboBoxItem Content="50" IsSelected="True"/>
                        <ComboBoxItem Content="100"/>
                        <ComboBoxItem Content="200"/>
                        <ComboBoxItem Content="500"/>
                        <ComboBoxItem Content="All"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="PART_FirstPage" Content="«" Style="{StaticResource PagingButton}" Margin="2,0" Click="FirstPage_Click" ToolTip="First page"/>
                    <Button x:Name="PART_PrevPage" Content="‹" Style="{StaticResource PagingButton}" Margin="2,0" Click="PrevPage_Click" ToolTip="Previous page"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="Page " FontSize="11" FontFamily="Segoe UI" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="PART_PageInput" Width="36" Height="24" FontSize="11" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="PageInput_KeyDown" LostFocus="PageInput_LostFocus" Background="{DynamicResource CardContentBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <TextBlock x:Name="PART_PageTotal" Text=" of 1" FontSize="11" FontFamily="Segoe UI" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="PART_NextPage" Content="›" Style="{StaticResource PagingButton}" Margin="2,0" Click="NextPage_Click" ToolTip="Next page"/>
                    <Button x:Name="PART_LastPage" Content="»" Style="{StaticResource PagingButton}" Margin="2,0" Click="LastPage_Click" ToolTip="Last page"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PART_FilterBadge" Background="{DynamicResource PhaseHeaderYBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                        <TextBlock x:Name="PART_FilterBadgeText" Text="Filters active" FontSize="10" FontFamily="Segoe UI" Foreground="{DynamicResource PhaseHeaderYTextBrush}"/>
                    </Border>
                    <Button Content="Clear All Filters" Style="{StaticResource PagingButton}" Margin="6,0,0,0" FontSize="10" Click="Filter_ClearAll_Click" x:Name="PART_ClearAllFiltersBtn" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="PART_FilterPopup" Grid.Row="0" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8" MinWidth="380" MaxWidth="480" MaxHeight="500">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource AccentColor}"/>
                        </Border.Background>
                        <TextBlock Text="Column Options" FontSize="15" FontWeight="Bold" Foreground="White" Margin="18,14"/>
                    </Border>

                    <TabControl Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderThickness="0">
                        <TabItem Header="Search &amp; Sort" Style="{StaticResource TabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Margin="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Search in Column" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PART_SearchBox" Grid.Column="0" Height="34" Padding="12,8" FontSize="12" Background="{DynamicResource ContentAreaBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" KeyDown="SearchBox_KeyDown"/>
                                            <Button Grid.Column="1" Content="✕" Width="34" Height="34" Margin="10,0,0,0" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Click="ClearSearch_Click" ToolTip="Clear" Style="{StaticResource PagingButton}"/>
                                        </Grid>

                                        <Separator Margin="0,0,0,18" Background="{DynamicResource CardBorderBrush}" Height="1"/>

                                        <TextBlock Text="Sort Column" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="↑ Ascending" Width="160" Height="36" FontSize="12" Margin="0,0,10,0" Style="{StaticResource PagingButton}" Click="Sort_Asc_Click"/>
                                            <Button Content="↓ Descending" Width="160" Height="36" FontSize="12" Style="{StaticResource PagingButton}" Click="Sort_Desc_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Filter" Style="{StaticResource TabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Margin="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Filter Operators" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12" Foreground="{DynamicResource AccentBrush}"/>
                                        <WrapPanel Margin="0,0,0,18">
                                            <Button Content="Equals" Width="110" Height="34" FontSize="11" Margin="0,0,8,8" Style="{StaticResource PagingButton}" Click="Filter_Equals_Click"/>
                                            <Button Content="Contains" Width="110" Height="34" FontSize="11" Margin="0,0,8,8" Style="{StaticResource PagingButton}" Click="Filter_Contains_Click"/>
                                            <Button Content="Starts With" Width="110" Height="34" FontSize="11" Margin="0,0,8,8" Style="{StaticResource PagingButton}" Click="Filter_StartsWith_Click"/>
                                            <Button Content="Ends With" Width="110" Height="34" FontSize="11" Margin="0,0,8,8" Style="{StaticResource PagingButton}" Click="Filter_EndsWith_Click"/>
                                            <Button Content="Greater (&gt;)" Width="110" Height="34" FontSize="11" Margin="0,0,8,8" Style="{StaticResource PagingButton}" Click="Filter_Greater_Click"/>
                                            <Button Content="Less (&lt;)" Width="110" Height="34" FontSize="11" Margin="0,0,8,8" Style="{StaticResource PagingButton}" Click="Filter_Less_Click"/>
                                        </WrapPanel>

                                        <Separator Margin="0,0,0,18" Background="{DynamicResource CardBorderBrush}" Height="1"/>

                                        <TextBlock Text="Clear Filters" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource AccentBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Clear This Column" Width="160" Height="36" FontSize="11" Margin="0,0,10,0" Style="{StaticResource PagingButton}" Click="Filter_ClearThis_Click"/>
                                            <Button Content="Clear All Filters" Width="160" Height="36" FontSize="11" Style="{StaticResource PagingButton}" Click="Filter_ClearAll_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Columns" Style="{StaticResource TabItemStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource ContentAreaBgBrush}" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Text="Search Columns:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PART_ColumnSearchBox" Height="30" Padding="10,6" FontSize="11" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" TextChanged="ColumnSearchBox_TextChanged"/>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,1">
                                    <Border Margin="12">
                                        <ItemsControl x:Name="PART_ColumnCheckList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="6,5" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </ScrollViewer>

                                <Border Grid.Row="2" Background="{DynamicResource ContentAreaBgBrush}" Padding="18,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Show All" Width="100" Height="34" FontSize="11" Margin="0,0,8,0" Style="{StaticResource PagingButton}" Click="Columns_ShowAll_Click"/>
                                        <Button Content="Hide All" Width="100" Height="34" FontSize="11" Margin="0,0,8,0" Style="{StaticResource PagingButton}" Click="Columns_HideAll_Click"/>
                                        <Button Content="Auto-size All" Width="120" Height="34" FontSize="11" Style="{StaticResource PagingButton}" Click="View_AutosizeAll_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>

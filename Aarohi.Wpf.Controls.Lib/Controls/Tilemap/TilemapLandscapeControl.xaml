<UserControl x:Class="Aarohi.Wpf.Controls.Lib.Controls.Tilemap.TilemapLandscapeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Loaded="Root_Loaded"
             Unloaded="Root_Unloaded"
             SizeChanged="Root_SizeChanged"
             ClipToBounds="True">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop x:Name="BackgroundTopStop" Color="#FFFFFF" Offset="0" />
                <GradientStop x:Name="BackgroundBottomStop" Color="#E9EEF5" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="950"
                 Height="390"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,25,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.45">
                    <GradientStop x:Name="TopGlowInnerStop" Color="#FAFFFFFF" Offset="0" />
                    <GradientStop x:Name="TopGlowOuterStop" Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- The tilemap is rendered into this canvas, with an optional radial reveal on first render. -->
        <Canvas x:Name="TileCanvas"
                IsHitTestVisible="False"
                SnapsToDevicePixels="False" />

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="HorizonFadeStrongStop" Color="#FAFFFFFF" Offset="0.00" />
                    <GradientStop x:Name="HorizonFadeMidStop" Color="#E0FFFFFF" Offset="0.16" />
                    <GradientStop x:Name="HorizonFadeSoftStop" Color="#38FFFFFF" Offset="0.40" />
                    <GradientStop x:Name="HorizonFadeClearStop" Color="#00FFFFFF" Offset="0.70" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
